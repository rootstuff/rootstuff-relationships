{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "relatewp/related-content",
	"version": "0.1.0",
	"title": "Related Content",
	"category": "widgets",
	"icon": "networking",
	"description": "Display content related to the current post via RelateWP.",
	"attributes": {
		"relType": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "relatewp",
	"editorScript": "relatewp-related-content-editor",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
